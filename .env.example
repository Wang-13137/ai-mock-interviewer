# 复制为 .env 后再填，.env 已在 .gitignore 中，不会进 Git。
# 规则：AIMI_ 前缀 + 双下划线分层，覆盖 config/default.yaml 的同名项。

# 供应商：mock | zhipu | siliconflow | deepseek | openai
AIMI_LLM__PROVIDER=mock

# 也可以直接在这里给 Key（优先级高于厂商同名变量）
# AIMI_LLM__API_KEY=

# 或者填厂商约定的变量名（任选其一即可）
# ZHIPU_API_KEY=          # https://open.bigmodel.cn  免费模型 glm-4-flash
# SILICONFLOW_API_KEY=    # https://cloud.siliconflow.cn
# DEEPSEEK_API_KEY=       # https://platform.deepseek.com
# OPENAI_API_KEY=

# 可选覆盖
# AIMI_LLM__MODEL=glm-4-flash
# AIMI_LLM__TEMPERATURE=0.7
# AIMI_METRICS__ENABLED=true
